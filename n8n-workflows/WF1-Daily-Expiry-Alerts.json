{
  "name": "WF1: Daily Expiry Alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Daily at 9 AM",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "httpHeaderAuth": {
          "name": "Authorization",
          "value": "={{ 'Bearer ' + $env.API_TOKEN }}"
        },
        "url": "={{ $env.API_BASE_URL || 'http://127.0.0.1:8000/api/v0.1' }}/pantry/expiring",
        "options": {
          "queryParameters": {
            "parameters": [
              {
                "name": "days",
                "value": "7"
              }
            ]
          }
        }
      },
      "id": "fetch-expiring-items",
      "name": "Fetch Expiring Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-items-exist",
      "name": "Check Items Exist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Format expiring items for notification\nconst items = $input.all();\nconst expiringItems = items.map(item => {\n  const data = item.json;\n  const expiryDate = new Date(data.expiry_date);\n  const today = new Date();\n  const daysUntil = Math.ceil((expiryDate - today) / (1000 * 60 * 60 * 24));\n  \n  return {\n    ingredient: typeof data.ingredient === 'object' ? data.ingredient.name : data.ingredient,\n    quantity: data.quantity,\n    unit: typeof data.unit === 'object' ? (data.unit.abbreviation || data.unit.name) : data.unit,\n    expiryDate: data.expiry_date,\n    daysUntil: daysUntil,\n    location: data.location\n  };\n});\n\n// Group by days until expiry\nconst grouped = {};\nexpiringItems.forEach(item => {\n  const key = item.daysUntil <= 0 ? 'expired' : \n              item.daysUntil === 1 ? 'tomorrow' : \n              item.daysUntil <= 3 ? 'this-week' : 'next-week';\n  if (!grouped[key]) grouped[key] = [];\n  grouped[key].push(item);\n});\n\n// Build message\nlet message = '🍽️ Daily Expiry Alert\\n\\n';\n\nif (grouped.expired && grouped.expired.length > 0) {\n  message += '⚠️ EXPIRED ITEMS:\\n';\n  grouped.expired.forEach(item => {\n    message += `• ${item.ingredient} (${item.quantity} ${item.unit}) - Expired\\n`;\n  });\n  message += '\\n';\n}\n\nif (grouped.tomorrow && grouped.tomorrow.length > 0) {\n  message += '🔴 Expiring Tomorrow:\\n';\n  grouped.tomorrow.forEach(item => {\n    message += `• ${item.ingredient} (${item.quantity} ${item.unit})\\n`;\n  });\n  message += '\\n';\n}\n\nif (grouped['this-week'] && grouped['this-week'].length > 0) {\n  message += '🟡 Expiring This Week:\\n';\n  grouped['this-week'].forEach(item => {\n    message += `• ${item.ingredient} (${item.quantity} ${item.unit}) - ${item.daysUntil} days\\n`;\n  });\n  message += '\\n';\n}\n\nif (grouped['next-week'] && grouped['next-week'].length > 0) {\n  message += '🟢 Expiring Next Week:\\n';\n  grouped['next-week'].forEach(item => {\n    message += `• ${item.ingredient} (${item.quantity} ${item.unit}) - ${item.daysUntil} days\\n`;\n  });\n}\n\nreturn {\n  json: {\n    message: message,\n    items: expiringItems,\n    totalCount: expiringItems.length\n  }\n};"
      },
      "id": "format-message",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM || 'noreply@homelife.app' }}",
        "toEmail": "={{ $env.EMAIL_TO }}",
        "subject": "Daily Expiry Alert - HomeLife",
        "emailType": "html",
        "message": "={{ $json.message.replace(/\\n/g, '<br>') }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1050, 200],
      "credentials": {
        "smtp": {
          "id": "smtp-credentials",
          "name": "SMTP Account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "send-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1050, 300],
      "credentials": {
        "telegramApi": {
          "id": "telegram-credentials",
          "name": "Telegram Account"
        }
      }
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_CHANNEL || '#notifications' }}",
        "text": "={{ $json.message }}",
        "otherOptions": {
          "username": "HomeLife Bot"
        }
      },
      "id": "send-slack",
      "name": "Send Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1050, 400],
      "credentials": {
        "slackApi": {
          "id": "slack-credentials",
          "name": "Slack Account"
        }
      }
    }
  ],
  "connections": {
